{
  // F5 abre a depuração do backend. Antes, selecione o Python de backend/.venv.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Oficina: depurar FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
