{
  // Execute as tarefas depois de instalar as dependências descritas no README.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Oficina: backend",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe" },
      "args": ["-m", "uvicorn", "main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Oficina: frontend",
      "type": "shell",
      "command": "npm run dev",
      "windows": { "command": "npm.cmd run dev" },
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
